# Local .terraform directory (provider plugins and binaries)
**/.terraform/*

# State files (contains unencrypted secrets and infrastructure data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files and crash logs
crash.log
crash.*.log
*.tfplan
tfplan

# Sensitive variable files
*.tfvars
*.tfvars.json.tmp

# Private keys and credentials
*.pem
*.key
id_rsa
id_rsa.pub

# macOS metadata
.DS_Store
**/.DS_Store